# Local/dev variant of Dockerfile: same production build, but served over plain HTTP with no
# domain or TLS requirement - see docker-compose.local.yml and run.sh. For an actual deployment,
# use Dockerfile + docker-compose.prod.yml + DEPLOYMENT.md instead.

# ---- Build stage ----
FROM node:20-alpine AS build
WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine

RUN apk add --no-cache curl && rm -f /etc/nginx/conf.d/default.conf

COPY --from=build /build/dist /usr/share/nginx/html
COPY nginx/local.conf /etc/nginx/conf.d/app.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -f http://localhost/ || exit 1
