# Copy this file to `.env` in the repo root (same directory as docker-compose.prod.yml) and fill
# in every value below. Never commit the real `.env` - it's already covered by .gitignore.

# ---- Domain ----
# The bare domain only, no scheme/protocol (used for nginx server_name, the TLS cert, and CORS).
DOMAIN=city-apartments.in

# ---- Database ----
DB_NAME=society_portal
DB_USERNAME=society_admin
# Generate with: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# ---- Auth ----
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes. Rotating this invalidates every issued JWT (forces re-login).
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=7

# ---- Email (SMTP) ----
# Used for OTP delivery, registration/approval notices, password resets, notification digests.
MAIL_ENABLED=true
# GoDaddy "Workspace Email" / "Email Essentials" (a plain @city-apartments.in mailbox bought
# through GoDaddy): host smtpout.secureserver.net, port 587, username is the full mailbox address,
# password is that mailbox's normal login password (no app password needed, unlike Gmail).
#
# If instead your GoDaddy email is "Microsoft 365 Email" (actually hosted by Microsoft): use
# smtp.office365.com on port 587, same username/password (an app password if MFA is enabled).
#
# If using plain Gmail/Google Workspace instead: smtp.gmail.com, port 587, and MAIL_PASSWORD must
# be an App Password (myaccount.google.com -> Security -> 2-Step Verification -> App passwords),
# not the account's normal login password.
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=587
MAIL_USERNAME=admin@city-apartments.in
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=admin@city-apartments.in

# ---- SMS ----
# No real SMS provider is wired into the codebase yet (see backend/.../service/SmsService.java) -
# leave this false until one is integrated, otherwise SMS sends will silently no-op.
SMS_ENABLED=false

# ---- Misc ----
SOCIETY_NAME=Your Society Name

# ---- Let's Encrypt ----
# Only used by deploy/init-letsencrypt.sh (renewal expiry notices go here, not app functionality).
LETSENCRYPT_EMAIL=admin@city-apartments.in
